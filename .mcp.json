{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "terraform": {
      "command": "docker",
      "args": [
        "run", "-i", "--rm",
        "-e", "TFE_TOKEN=${TFE_TOKEN}",
        "hashicorp/terraform-mcp-server:0.4.0"
      ]
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://tempo:${POSTGRES_PASSWORD}@localhost:5432/tempo"
      ]
    },
    "redis": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-redis",
        "redis://:${REDIS_PASSWORD}@localhost:6379"
      ]
    },
    "grafana": {
      "command": "uvx",
      "args": ["mcp-grafana"],
      "env": {
        "GRAFANA_URL": "https://grafana.tempo-hub.fr",
        "GRAFANA_API_KEY": "${GRAFANA_API_KEY}"
      }
    },
    "docker": {
      "command": "npx",
      "args": ["-y", "@quantgeekdev/docker-mcp"]
    },
    "n8n": {
      "command": "npx",
      "args": ["-y", "n8n-mcp"],
      "env": {
        "N8N_API_URL": "https://n8n.tempo-hub.fr/api/v1",
        "N8N_API_KEY": "${N8N_API_KEY}"
      }
    },
    "authentik": {
      "command": "npx",
      "args": ["-y", "authentik-mcp"],
      "env": {
        "AUTHENTIK_URL": "https://auth.tempo-hub.fr",
        "AUTHENTIK_TOKEN": "${AUTHENTIK_TOKEN}"
      }
    }
  }
}
