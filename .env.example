# ── App ──
APP_NAME=tempo-hub
DOMAIN=tempo-hub.fr

# ── Traefik / SSL ──
ACME_EMAIL=admin@tempo-hub.fr

# ── Storage ──
UPLOADS_PATH=./data/uploads
# Max upload storage per client (used by quota script)
STORAGE_QUOTA_MB=500

# ── Stripe ──
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
NUXT_STRIPE_SECRET_KEY=sk_test_...
NUXT_STRIPE_WEBHOOK_SECRET=whsec_...

# ── Strapi ──
HOST=0.0.0.0
PORT=1337
# PUBLIC_URL: The public-facing URL of your Strapi instance (used for admin panel, emails, webhooks)
# Production: https://tempo-hub.fr
# Local development: http://localhost:1337
PUBLIC_URL=https://tempo-hub.fr
APP_KEYS=toBeGenerated1,toBeGenerated2,toBeGenerated3,toBeGenerated4
API_TOKEN_SALT=toBeGenerated
ADMIN_JWT_SECRET=toBeGenerated
TRANSFER_TOKEN_SALT=toBeGenerated
JWT_SECRET=toBeGenerated
# ENCRYPTION_KEY: Required in Strapi v5 for encrypted fields
ENCRYPTION_KEY=toBeGenerated

# ── Database (PostgreSQL) ──
DATABASE_CLIENT=postgres
# DATABASE_HOST: 'postgres' in Docker (service name), 'localhost' for local dev
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=toBeGenerated

# ── Nuxt ──
# NUXT_PUBLIC_STRAPI_URL: 'http://strapi:1337' in Docker (container network), 'http://localhost:1337' for local dev
NUXT_PUBLIC_STRAPI_URL=http://strapi:1337
NUXT_PUBLIC_GA_ID=
